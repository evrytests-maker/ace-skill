{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "gates"],
  "properties": {
    "version": { "type": "string" },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "appliesWhen", "passCriteria", "failCriteria", "examples", "requiredEvidence", "naAllowed"],
        "properties": {
          "id": { "type": "string", "pattern": "^MG-[A-Z0-9-]+$" },
          "question": { "type": "string" }, "appliesWhen": { "type": "string" },
          "passCriteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "failCriteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "examples": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "requiredEvidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "naAllowed": { "type": "boolean" }, "naWhen": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

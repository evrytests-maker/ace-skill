      "shouldTrigger": true,
      "requiredWorkflow": "character-repair",
      "requiredReferences": ["references/character-cards.md"],
      "forbiddenReferences": ["references/lorebooks.md"],
      "requiredRules": ["ACE-CORE-004", "ACE-CARD-001", "ACE-CARD-002", "ACE-CARD-003", "ACE-CARD-004", "ACE-STYLE-001"],
      "requiredValidators": ["VAL-CARD", "VAL-STYLE", "VAL-TOKENS", "VAL-EVIDENCE"],
      "requiredOutputs": ["repaired V3 card", "change summary", "evidence ledger"],
      "assertions": ["records original failures", "repairs user control", "reruns every failed mandatory gate"],
      "prohibitedBehavior": ["enforces an exact universal dialogue count", "reports repaired content without reopening it"],
      "evidence": ["before/after field paths", "fresh validator output", "independent manual review"]
    },
    {

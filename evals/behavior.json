    {
      "id": "B01-CARD-CREATE",
      "prompt": "Создай V2-карточку SillyTavern для осторожной архивистки Миры. Greeting должен оставить выбор пользователю, а примеры — показать деловой и доверительный режимы. Не используй риторику вида 'she is not X, she is Y' или смысловые аналоги. Верни JSON и evidence.",
      "shouldTrigger": true,
      "requiredWorkflow": "character-create",
      "requiredReferences": ["references/character-cards.md"],
      "forbiddenReferences": ["references/lorebooks.md"],
      "requiredRules": ["ACE-CORE-001", "ACE-CORE-002", "ACE-CORE-003", "ACE-CARD-001", "ACE-CARD-002", "ACE-CARD-003", "ACE-CARD-004", "ACE-STYLE-001", "ACE-STYLE-002"],
      "requiredValidators": ["VAL-CARD", "VAL-STYLE", "VAL-TOKENS", "VAL-EVIDENCE"],
      "requiredOutputs": ["valid V2 card JSON", "manual-gate findings", "evidence ledger"],
      "assertions": ["uses character-create only", "preserves user agency", "contains no replacement-by-negation construction or semantic equivalent", "validates the final artifact rather than a summary"],
      "prohibitedBehavior": ["loads the lorebook guide", "uses denial-then-replacement rhetoric", "claims PASS without command and reviewer evidence"],
      "evidence": ["reference read event with SHA-256", "card and style validator exit codes", "field-level reviewer citations", "MG-STYLE-CONTRAST reviewer evidence"]
    },
    {
      "id": "B02-CARD-REPAIR",
